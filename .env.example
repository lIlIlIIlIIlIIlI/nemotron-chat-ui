# Local development. Production uses the deployed Worker HTTPS URL.
CLOUDFLARE_D1_URL=http://127.0.0.1:8787
# Must match the Worker's D1_PROXY_SECRET. Use a separate secret per environment.
CLOUDFLARE_D1_SECRET=
AUTH_SECRET=
# Exactly 32 random bytes, base64 encoded. Preserve this key when importing encrypted credentials.
APP_ENCRYPTION_KEY=
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Nemotron Workspace
AI_ALLOWED_HOSTS=
